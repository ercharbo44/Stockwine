{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "France schématique et repères viticoles indicatifs, sans limites de vignobles.",
    "width": "container",
    "height": "container",
    "autosize": { "type": "fit", "contains": "padding" },
    "projection": { "type": "mercator" },
    "layer": [
        {
            "data": {
                "values": {
                    "type": "Feature",
                    "geometry": {
                        "type": "MultiPolygon",
                        "coordinates": [
                            [[[-4.8,48.5],[-3.4,48.8],[-1.9,48.6],[-1.9,49.7],[-1.2,49.7],[-1.1,49.3],[0.2,49.5],[1.6,50.9],[2.5,51.1],[4.2,50],[4.8,50.1],[5.8,49.5],[6.4,49.5],[7.2,49.1],[8.2,49],[7.6,48.1],[7.6,47.6],[7,47.5],[6.8,47],[6,46.6],[6.1,46.2],[6.8,46.4],[7,45.9],[7.1,45.3],[6.6,45.1],[7,44.3],[7.7,44.2],[7.5,43.8],[6.2,43.1],[5.4,43.2],[4.1,43.6],[3.1,43],[3.2,42.4],[2,42.4],[0.7,42.7],[-0.7,42.9],[-1.8,43.4],[-1.2,44.6],[-1.1,45.5],[-1.8,46.5],[-2.2,47.2],[-3.1,47.6],[-4.4,47.8],[-4.8,48.5]]],
                            [[[9.4,43],[9.5,42.6],[9.4,42.1],[9.3,41.4],[8.8,41.6],[8.6,42],[8.6,42.4],[9.1,42.7],[9.4,43]]]
                        ]
                    }
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "var(--color-secondary)",
                "stroke": "var(--color-border)"
            }
        },
        {
            "transform": [
                { "calculate": "abs(datum['CA net'])", "as": "Montant" }
            ],
            "encoding": {
                "longitude": { "field": "Longitude", "type": "quantitative" },
                "latitude": { "field": "Latitude", "type": "quantitative" },
                "tooltip": [
                    { "field": "VinRégion", "type": "nominal", "title": "Origine viticole" },
                    { "field": "CA net", "type": "quantitative", "title": "CA net (€)" },
                    { "field": "Bouteilles", "type": "quantitative", "title": "Bouteilles" }
                ]
            },
            "layer": [
                {
                    "mark": { "type": "circle", "opacity": 0.8, "color": "var(--color-brand)" },
                    "encoding": {
                        "size": {
                            "field": "Montant",
                            "type": "quantitative",
                            "scale": { "zero": true, "range": [0, 1200] },
                            "legend": null
                        },
                        "stroke": {
                            "condition": { "test": "datum['CA net'] < 0", "value": "var(--color-destructive)" },
                            "value": "var(--color-card)"
                        },
                        "strokeWidth": { "value": 2 }
                    }
                },
                {
                    "transform": [{ "filter": "datum['CA net'] == null || datum['CA net'] == 0" }],
                    "mark": { "type": "point", "size": 64, "color": "var(--color-brand)" }
                },
                {
                    "mark": { "type": "text", "dy": -23, "color": "var(--color-foreground)" },
                    "encoding": { "text": { "field": "VinRégion", "type": "nominal" } }
                }
            ]
        }
    ]
}
